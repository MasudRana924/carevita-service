BKASH_EXECUTE_URL=https://checkout.sandbox.bka.sh/v1.2.0-beta/checkout/payment/execute/
BKASH_TOKEN_URL=https://checkout.sandbox.bka.sh/v1.2.0-beta/checkout/token/grant
BKASH_SCRIPT=https://scripts.sandbox.bka.sh/versions/1.2.0-beta/checkout/bKash-checkout-sandbox.js
