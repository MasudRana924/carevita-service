{
  "info": {
    "name": "CareMate API v2 — Final",
    "description": "Base: http://localhost:8000/api/v1\nAuth header: Bearer {{token}}\n\nFolders:\n- Shared Auth & FCM\n- USER App\n- CAREGIVER App\n- ADMIN (optional)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000/api/v1" },
    { "key": "userToken", "value": "" },
    { "key": "caregiverToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "bookingId", "value": "" },
    { "key": "familyMemberId", "value": "" },
    { "key": "caregiverProfileId", "value": "" },
    { "key": "hospitalId", "value": "" },
    { "key": "inboxId", "value": "" }
  ],
  "item": [
    {
      "name": "1. Shared Auth",
      "item": [
        {
          "name": "Register (USER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahim Ahmed\",\n  \"email\": \"user@example.com\",\n  \"password\": \"Pass1234\",\n  \"role\": \"USER\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Register (CAREGIVER)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Karim Caregiver\",\n  \"email\": \"caregiver@example.com\",\n  \"password\": \"Pass1234\",\n  \"role\": \"CAREGIVER\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/send-otp"
          }
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "url": "{{baseUrl}}/auth/verify-otp"
          }
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\"\n}"
            },
            "url": "{{baseUrl}}/auth/resend-otp"
          }
        },
        {
          "name": "Login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "const token = j.data?.accessToken || j.data?.token || j.accessToken;",
                  "if (token) pm.collectionVariables.set('userToken', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"Pass1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Login (Caregiver)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "const token = j.data?.accessToken || j.data?.token || j.accessToken;",
                  "if (token) pm.collectionVariables.set('caregiverToken', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"caregiver@example.com\",\n  \"password\": \"Pass1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Get Auth Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "Update Auth Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rahim Updated\",\n  \"address\": \"Dhaka\",\n  \"emergency_contact\": \"01700000000\"\n}"
            },
            "url": "{{baseUrl}}/auth/profile"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"YOUR_REFRESH_TOKEN\"\n}"
            },
            "url": "{{baseUrl}}/auth/refresh-token"
          }
        }
      ]
    },
    {
      "name": "2. FCM Tokens (Both Apps)",
      "item": [
        {
          "name": "Register FCM Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{userToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"device-001\",\n  \"platform\": \"android\",\n  \"token\": \"YOUR_FCM_DEVICE_TOKEN\"\n}"
            },
            "url": "{{baseUrl}}/notifications/tokens"
          }
        },
        {
          "name": "List My FCM Tokens",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/notifications/tokens"
          }
        },
        {
          "name": "Delete FCM Token",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
            "url": "{{baseUrl}}/notifications/tokens/TOKEN_UUID"
          }
        }
      ]
    },
    {
      "name": "3. USER App",
      "item": [
        {
          "name": "Profile",
          "item": [
            {
              "name": "Get My Profile",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "url": "{{baseUrl}}/user/profile"
              }
            },
            {
              "name": "Update My Profile",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "name", "value": "Rahim Ahmed", "type": "text" },
                    { "key": "address", "value": "Dhaka", "type": "text" },
                    { "key": "emergency_contact", "value": "01700000000", "type": "text" },
                    { "key": "profile_photo", "type": "file", "src": [] }
                  ]
                },
                "url": "{{baseUrl}}/user/profile"
              }
            }
          ]
        },
        {
          "name": "Family Members",
          "item": [
            {
              "name": "Add Family Member",
              "request": {
                "method": "POST",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "name", "value": "Abba", "type": "text" },
                    { "key": "relationship", "value": "Father", "type": "text" },
                    { "key": "phone", "value": "01700000000", "type": "text" },
                    { "key": "blood_group", "value": "B+", "type": "text" },
                    { "key": "district", "value": "Dhaka", "type": "text" },
                    { "key": "thana", "value": "Dhanmondi", "type": "text" },
                    { "key": "house", "value": "House 12, Road 5", "type": "text" },
                    { "key": "photo", "type": "file", "src": [] }
                  ]
                },
                "url": "{{baseUrl}}/family-members"
              }
            },
            {
              "name": "List Family Members",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "url": "{{baseUrl}}/family-members"
              }
            },
            {
              "name": "Get Family Member Details",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "url": "{{baseUrl}}/family-members/{{familyMemberId}}"
              }
            },
            {
              "name": "Update Family Member",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "name", "value": "Abba Updated", "type": "text" },
                    { "key": "district", "value": "Dhaka", "type": "text" },
                    { "key": "thana", "value": "Mirpur", "type": "text" },
                    { "key": "house", "value": "House 20, Block C", "type": "text" }
                  ]
                },
                "url": "{{baseUrl}}/family-members/{{familyMemberId}}"
              }
            },
            {
              "name": "Delete Family Member",
              "request": {
                "method": "DELETE",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "url": "{{baseUrl}}/family-members/{{familyMemberId}}"
              }
            }
          ]
        },
        {
          "name": "Caregiver List & Details",
          "item": [
            {
              "name": "Search Caregivers",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/caregiver/search?page=1&limit=20&district=Dhaka&thana=Dhanmondi"
              }
            },
            {
              "name": "View Caregiver Details",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/caregiver/{{caregiverProfileId}}"
              }
            }
          ]
        },
        {
          "name": "Hospitals",
          "item": [
            {
              "name": "List Hospitals",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/hospitals?page=1&limit=20"
              }
            },
            {
              "name": "Get Hospital Details",
              "request": {
                "method": "GET",
                "url": "{{baseUrl}}/hospitals/{{hospitalId}}"
              }
            }
          ]
        },
        {
          "name": "Bookings",
          "item": [
            {
              "name": "Create Booking",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const j = pm.response.json();",
                      "const id = j.data?.id;",
                      "if (id) pm.collectionVariables.set('bookingId', id);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{userToken}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"family_member_id\": \"{{familyMemberId}}\",\n  \"provider_id\": \"{{caregiverProfileId}}\",\n  \"hospital_id\": \"{{hospitalId}}\",\n  \"service_type\": \"HOSPITAL_ASSISTANCE\",\n  \"booking_date\": \"2026-09-20\",\n  \"start_time\": \"10:00\",\n  \"duration_hours\": 4,\n  \"notes\": \"Need help at hospital\"\n}"
                },
                "url": "{{baseUrl}}/bookings"
              }
            },
            {
              "name": "My Booking List",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "url": "{{baseUrl}}/bookings?page=1&limit=20"
              }
            },
            {
              "name": "Booking Details",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "url": "{{baseUrl}}/bookings/{{bookingId}}"
              }
            },
            {
              "name": "Cancel Booking",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{userToken}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reason\": \"Plans changed\"\n}"
                },
                "url": "{{baseUrl}}/bookings/{{bookingId}}/cancel"
              }
            }
          ]
        },
        {
          "name": "Inbox (Push → Details)",
          "item": [
            {
              "name": "List Inbox",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "url": "{{baseUrl}}/inbox?page=1&limit=20"
              }
            },
            {
              "name": "Unread Count",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "url": "{{baseUrl}}/inbox/unread-count"
              }
            },
            {
              "name": "Inbox Item Details",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "url": "{{baseUrl}}/inbox/{{inboxId}}"
              }
            },
            {
              "name": "Mark Inbox Read",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "url": "{{baseUrl}}/inbox/{{inboxId}}/read"
              }
            },
            {
              "name": "Mark All Read",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Authorization", "value": "Bearer {{userToken}}" }],
                "url": "{{baseUrl}}/inbox/read-all"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. CAREGIVER App",
      "item": [
        {
          "name": "Profile",
          "item": [
            {
              "name": "Create Caregiver Profile",
              "request": {
                "method": "POST",
                "header": [{ "key": "Authorization", "value": "Bearer {{caregiverToken}}" }],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "district", "value": "Dhaka", "type": "text" },
                    { "key": "thana", "value": "Dhanmondi", "type": "text" },
                    { "key": "bio", "value": "Experienced caregiver", "type": "text" },
                    { "key": "hourly_rate", "value": "500", "type": "text" },
                    { "key": "experience_years", "value": "5", "type": "text" },
                    { "key": "gender", "value": "male", "type": "text" },
                    { "key": "education", "value": "HSC", "type": "text" },
                    { "key": "profile_photo", "type": "file", "src": [] }
                  ]
                },
                "url": "{{baseUrl}}/caregiver/profile"
              }
            },
            {
              "name": "Get My Caregiver Profile",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{caregiverToken}}" }],
                "url": "{{baseUrl}}/caregiver/profile"
              }
            },
            {
              "name": "Update Caregiver Profile",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Authorization", "value": "Bearer {{caregiverToken}}" }],
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "district", "value": "Dhaka", "type": "text" },
                    { "key": "thana", "value": "Mirpur", "type": "text" },
                    { "key": "hourly_rate", "value": "550", "type": "text" },
                    { "key": "bio", "value": "Updated bio", "type": "text" }
                  ]
                },
                "url": "{{baseUrl}}/caregiver/profile"
              }
            }
          ]
        },
        {
          "name": "Bookings",
          "item": [
            {
              "name": "My Caregiver Bookings",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{caregiverToken}}" }],
                "url": "{{baseUrl}}/caregiver/bookings/my"
              }
            },
            {
              "name": "Booking Details",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{caregiverToken}}" }],
                "url": "{{baseUrl}}/bookings/{{bookingId}}"
              }
            },
            {
              "name": "Accept Booking",
              "request": {
                "method": "POST",
                "header": [{ "key": "Authorization", "value": "Bearer {{caregiverToken}}" }],
                "url": "{{baseUrl}}/caregiver/bookings/{{bookingId}}/accept"
              }
            },
            {
              "name": "Reject Booking",
              "request": {
                "method": "POST",
                "header": [
                  { "key": "Authorization", "value": "Bearer {{caregiverToken}}" },
                  { "key": "Content-Type", "value": "application/json" }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"reason\": \"Not available that day\"\n}"
                },
                "url": "{{baseUrl}}/caregiver/bookings/{{bookingId}}/reject"
              }
            }
          ]
        },
        {
          "name": "Inbox (Push → Details)",
          "item": [
            {
              "name": "List Inbox",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{caregiverToken}}" }],
                "url": "{{baseUrl}}/inbox?page=1&limit=20"
              }
            },
            {
              "name": "Unread Count",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{caregiverToken}}" }],
                "url": "{{baseUrl}}/inbox/unread-count"
              }
            },
            {
              "name": "Inbox Item Details",
              "request": {
                "method": "GET",
                "header": [{ "key": "Authorization", "value": "Bearer {{caregiverToken}}" }],
                "url": "{{baseUrl}}/inbox/{{inboxId}}"
              }
            },
            {
              "name": "Mark Inbox Read",
              "request": {
                "method": "PUT",
                "header": [{ "key": "Authorization", "value": "Bearer {{caregiverToken}}" }],
                "url": "{{baseUrl}}/inbox/{{inboxId}}/read"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "5. ADMIN",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "const token = j.data?.accessToken || j.data?.token || j.accessToken;",
                  "if (token) pm.collectionVariables.set('adminToken', token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin1234\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Admin Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/profile"
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/dashboard"
          }
        },
        {
          "name": "List Users",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/users?page=1&limit=20"
          }
        },
        {
          "name": "Block User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/users/USER_UUID/block"
          }
        },
        {
          "name": "Unblock User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/users/USER_UUID/unblock"
          }
        },
        {
          "name": "List Caregivers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/caregivers?page=1&limit=20"
          }
        },
        {
          "name": "Block Caregiver",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/caregivers/CAREGIVER_PROFILE_UUID/block"
          }
        },
        {
          "name": "Unblock Caregiver",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/caregivers/CAREGIVER_PROFILE_UUID/unblock"
          }
        },
        {
          "name": "Create Hospital",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Square Hospital", "type": "text" },
                { "key": "district", "value": "Dhaka", "type": "text" },
                { "key": "city", "value": "Dhaka", "type": "text" },
                { "key": "address", "value": "Panthapath", "type": "text" },
                { "key": "phone", "value": "01711111111", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/admin/hospitals"
          }
        },
        {
          "name": "List Hospitals (Admin)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/admin/hospitals"
          }
        },
        {
          "name": "Update Hospital",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "Square Hospital Updated", "type": "text" },
                { "key": "phone", "value": "01722222222", "type": "text" }
              ]
            },
            "url": "{{baseUrl}}/admin/hospitals/{{hospitalId}}"
          }
        }
      ]
    }
  ]
}
